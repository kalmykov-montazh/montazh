проходит и не сразу понимаете что случилось заходите в приложение счет заблокирован деньги на месте а снять их нельзя в испании банк по закону обязан знать кто клиент и откуда у него деньги блокирует чаще всего по трем причинам первая истек документ карточка резидента или паспорт просрочены а банк новый не получил решается это просто приносите новый документ или подтверждение что подали на продление вторая на счет пришла крупная сумма например от продажи квартиры в украине банк спросит откуда нужен договор продажи выписка и подтверждение перевода третья банк попросил обновить данные а письмо ушло вам просят указать работу и доход а вы не ответили и соответственно вам могут заморозить счет тянуть не стоит а вот спорить с отделением бесполезно оно само не решает отправьте документы туда откуда пришел запрос и сохраните доказательство о том что вы отправили эти документы и знайте если вы живете легально вам не могут просто отказать в базовом счете куэнта де паго басика это ваше право по закону контакты проверенных юристов которые помогают правильно завести крупные деньги у меня есть пишите в личку поделюсь", "whisper": "Вы идете оплатить картой, а оплата не проходит. И не сразу понимаете, что случилось. Заходите в приложение, счет заблокирован. Деньги на месте, а снять их нельзя. В Испании банк по закону обязан знать, кто клиент и откуда у него деньги. Блокируют чаще всего по трем причинам. Первая. Испек документ. Карточка резидента или паспорт просроченный, а банк новый не получил. Лишается это просто. Приносите новый документ или подтверждение, что подали на продление. Вторая. На счет пришла крупная сумма, например, от продажи квартиры в Украине. Банк спросит, откуда деньги. Нужен договор продажи, выписка и подтверждение перевода. Третье. Банк попросил обновить данные, а письмо ушло в спам. Просят указать работу и доход, а вы не ответили и, соответственно, вам могут заморозить счет. Тянуть не стоит, а вот спорить с отделением бесполезно, оно само не решает. Отправьте документы туда, откуда пришел запрос и сохраните доказательства о том, что вы отправили эти документы. И знайте, если вы живете в Испании легально, вам не могут просто отказать в базовом счете. Cuenta de pago basica. Это ваше право по закону. Контакты проверенных юристов, которые помогают правильно завести крупные деньги, у меня есть. Пишите в личку, поделюсь.", "gw": [{"w": "вы", "s": 0.08, "e": 0.16}, {"w": "идете", "s": 0.24, "e": 0.48}, {"w": "платить", "s": 0.56, "e": 0.84}, {"w": "картой", "s": 0.92, "e": 1.2}, {"w": "а", "s": 1.28, "e": 1.32}, {"w": "оплата", "s": 1.4, "e": 1.68}, {"w": "не", "s": 1.76, "e": 1.84}, {"w": "проходит", "s": 1.88, "e": 2.24}, {"w": "и", "s": 2.28, "e": 2.32}, {"w": "не", "s": 2.4, "e": 2.48}, {"w": "сразу", "s": 2.52, "e": 2.76}, {"w": "понимаете", "s": 2.8, "e": 3.24}, {"w": "что", "s": 3.28, "e": 3.4}, {"w": "случилось", "s": 3.48, "e": 3.84}, {"w": "заходите", "s": 3.96, "e": 4.32}, {"w": "в", "s": 4.36, "e": 4.4}, {"w": "приложение", "s": 4.44, "e": 4.88}, {"w": "счет", "s": 5.0, "e": 5.2}, {"w": "заблокирован", "s": 5.2, "e": 5.76}, {"w": "деньги", "s": 5.877, "e": 6.158}, {"w": "на", "s": 6.197, "e": 6.277}, {"w": "месте", "s": 6.357, "e": 6.597}, {"w": "а", "s": 6.677, "e": 6.717}, {"w": "снять", "s": 6.797, "e": 7.037}, {"w": "их", "s": 7.117, "e": 7.238}, {"w": "нельзя", "s": 7.318, "e": 7.597}, {"w": "в", "s": 7.677, "e": 7.717}, {"w": "испании", "s": 7.797, "e": 8.197}, {"w": "банк", "s": 8.278, "e": 8.477}, {"w": "по", "s": 8.558, "e": 8.637}, {"w": "закону", "s": 8.717, "e": 8.997}, {"w": "обязан", "s": 9.117, "e": 9.477}, {"w": "знать", "s": 9.558, "e": 9.797}, {"w": "кто", "s": 9.917, "e": 10.077}, {"w": "клиент", "s": 10.157, "e": 10.477}, {"w": "и", "s": 10.557, "e": 10.597}, {"w": "откуда", "s": 10.677, "e": 10.957}, {"w": "у", "s": 10.997, "e": 11.037}, {"w": "него", "s": 11.077, "e": 11.278}, {"w": "деньги", "s": 11.278, "e": 11.517}, {"w": "блокирует", "s": 11.69, "e": 12.17}, {"w": "чаще", "s": 12.21, "e": 