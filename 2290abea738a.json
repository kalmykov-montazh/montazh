жают не потому, что сделали ошибку, а потому, что поняли, что это не их формат жизни. Так что не спрашивайте, хорошая Испания или плохая. Спросите себя, ваша ли она по характеру. Угадали с собой – это любовно -долго. тепло, спокойно. Не угадали? Никакое море вас не спасет.", "gw": [{"w": "люди", "s": 0.04, "e": 0.24}, {"w": "уезжают", "s": 0.28, "e": 0.64}, {"w": "из", "s": 0.68, "e": 0.8}, {"w": "испании", "s": 0.84, "e": 1.16}, {"w": "не", "s": 1.2, "e": 1.28}, {"w": "потому", "s": 1.32, "e": 1.56}, {"w": "что", "s": 1.56, "e": 1.68}, {"w": "здесь", "s": 1.72, "e": 1.88}, {"w": "плохо", "s": 1.92, "e": 2.12}, {"w": "а", "s": 2.16, "e": 2.2}, {"w": "потому", "s": 2.28, "e": 2.52}, {"w": "что", "s": 2.52, "e": 2.6}, {"w": "ожидали", "s": 2.64, "e": 3.04}, {"w": "совсем", "s": 3.08, "e": 3.32}, {"w": "другое", "s": 3.36, "e": 3.64}, {"w": "почему", "s": 3.72, "e": 4.0}, {"w": "люди", "s": 4.0, "e": 4.2}, {"w": "уезжают", "s": 4.24, "e": 4.64}, {"w": "из", "s": 4.68, "e": 4.76}, {"w": "испании", "s": 4.84, "e": 5.2}, {"w": "обратно", "s": 5.32, "e": 5.6}, {"w": "домой", "s": 5.64, "e": 5.88}, {"w": "чаще", "s": 6.042, "e": 6.283}, {"w": "всего", "s": 6.322, "e": 6.522}, {"w": "отъезд", "s": 6.602, "e": 6.962}, {"w": "происходит", "s": 7.002, "e": 7.402}, {"w": "не", "s": 7.402, "e": 7.522}, {"w": "сразу", "s": 7.562, "e": 7.762}, {"w": "обычно", "s": 7.842, "e": 8.122}, {"w": "проходит", "s": 8.163, "e": 8.522}, {"w": "год", "s": 8.562, "e": 8.682}, {"w": "иногда", "s": 8.762, "e": 9.082}, {"w": "два", "s": 9.122, "e": 9.243}, {"w": "и", "s": 9.322, "e": 9.362}, {"w": "человек", "s": 9.443, "e": 9.723}, {"w": "начинает", "s": 9.762, "e": 10.122}, {"w": "думать", "s": 10.122, "e": 10.363}, {"w": "о", "s": 10.403, "e": 10.443}, {"w": "возвращении", "s": 10.522, "e": 10.923}, {"w": "первая", "s": 11.042, "e": 11.282}, {"w": "причина", "s": 11.322, "e": 11.642}, {"w": "это", "s": 11.765, "e": 11.925}, {"w": "деньги", "s": 12.005, "e": 12.285}, {"w": "и", "s": 12.325, "e":