пока действует договор аренды квартира по закону считается вашим жильем испанская конституция говорит что жилье не прикос и защищает она того кто в нем живет именно на текущий момент поэтому собственник не может просто так прийти и войти в это жилье ни чтобы для того просто проверить как вы там живете без вашего согласия все это запрещено если он все таки вошел без разрешения то это уголовное преступление а я намьента де марада незаконное проникновение в жилище и наказание здесь уголовная статья от полугода до двух лет лишения свобода если с угрозами и силой он вошел то до четырех лет лишения свободы например сменить замок пока вас нет он тоже не имеет права и это тоже может быть преступление даже если нужен например срочный ремонт хозяин должен вас предупредить без вашего согласия войти в квартиру можно только по решению суда это единственное законное основание если в вашем договоре есть пункт что хозяин может заходить когда захочет или он уже нарушает ваши права контакты проверенных юристов у меня есть пишите в личку поделюсь", "whisper": "У вас под дверью стоит хозяин квартиры и требует его впустить. Вы имеете право отказать ему в этом. Пока действует договор аренды, квартира по закону считается вашим жильем. Испанская конституция говорит, что жилье неприкосновенно. И защищает она того, кто в нем живет именно на текущий момент. Поэтому собственник не может просто так прийти и войти в это жилье. Не чтобы для того просто проверить, как вы там живете. Без вашего согласия все это запрещено. Если он все -таки вошел без разрешения, то это уголовное преступление. Айянамиенто де марада. Незаконное проникновение в жилище. И наказание здесь уголовная статья от полугода до двух лет лишения свободы. Если с угрозами и силой он вошел, то до четырех лет лишения свободы. Например, сменить замок, пока вас нет. Он тоже не имеет права, и это тоже может быть преступлением. Даже если нужен, например, срочный ремонт, хозяин должен вас предупредить. Без вашего согласия войти в квартиру можно только по решению суда. Это единственное законное основание. Если в вашем договоре есть пункт, что хозяин может заходить, когда захочет, или он уже нарушает ваши права, контакты проверенных юристов у меня есть. Пишите в личку, поделюсь.", "gw": [{"w": "у", "s": 0.04, "e": 0.08}, {"w": "вас", "s": 0.12, "e": 0.24}, {"w": "под", "s": 0.28, "e": 0.4}, {"w": "дверью", "s": 0.44, "e": 0.72}, {"w": "стоит", "s": 0.76, "e": 0.96}, {"w": "хозяин", "s": 1.0, "e": 1.28}, {"w": "квартиры", "s": 1.32, "e": 1.68}, {"w": "и", "s": 1.72, "e": 1.76}, {"w": "требует", "s": 1.84, "e": 2.16}, {"w": "его", "s": 2.2, "e": 2.36}, {"w": "впустить", "s": 2.4, "e": 2.8}, {"w": "вы", "s": 2.84, "e": 2.96}, {"w": "имеете", "s": 3.0, "e": 3.32}, {"w": "полное", "s": 3.36, "e": 3.76}, {"w": "право", "s": 3.8, "e": 4.04}, {"w": "отказать", "s": 4.12, "e": 4.48}, {"w": "ему", "s": 4.52, "e": 4.68}, {"w": "в", "s": 4.72, "e": 4.76}, {"w": "этом", "s": 4.8, "e": 4.96}, {"w": "пока", "s": 5.037, "e": 5.237}, {"w": "действует", "s": 5.277, "e": 5.638}, {"w": "договор", "s": 5.637, "e": 5.957}, {"w": "аренды", "s": 5.997, "e": 6.318}, {"w": "квартира", "s": 6.398, "e": 6.757}, {"w": "по", "s": 6.797, "e": 6.877}, {"w": "закону", "s": 6.917, "e": 7.157}, {"w": "считается", "s": 7.238, "e": 7.637}, {"w": "вашим", "s": 7.677, "e": 7.917}, {"w": "жильем", "s": 7.957, "e": 8.237}, {"w": "испанская", "s": 8.357, "e": 8.757}, {"w": "конституция", "s": 8.797, "e": 9.357}, {"w": "говорит", "s": 9.438, "e": 9.717}, {"w": "что", "s": 9.797, "e": 9.917}, {"w": "жилье", "s": 9.998, "e": 10.237}, {"w": "не", "s": 10.357, "e": 10.437}, {"w": "прикос", "s": 10.478, "e": 10.797}, {"w": "и", "s": 11.355, "e": 11.395}, {"w": "защищает", "s": 11.475, "e": 11.875}, {"w": "она", "s": 11.915, "e": 12.075}, {"w": "того", "s": 12.115, "e": 12.275}, {"w": "кто", "s": 12.315, "e": 12.475}, {"w": "в", "s": 12.515, "e": 12.555}, {"w": "нем", "s": 12.595, "e": 12.755}, {"w": "живет", "s": 12.795, "e": 12.995}, {"w": "именно