оне и тянуть ей невыгодно. По закону у нее есть 40 дней, чтобы начать платить и, соответственно, 3 месяца для того, чтобы вообще закрыть полностью этот вопрос. Если страховая просрочила, включается статья 20. На долг начисляются проценты и законная ставка это плюс 50%, а после 2 лет это минимум 20 % годовых. И они начисляются автоматически. Не платят? Сначала пиши в их отдел по работе с клиентами. Если не реагируют, то жалобу госрегулятору страховщиков.", "gw": [{"w": "цену", "s": 0.0, "e": 0.2}, {"w": "автостраховки", "s": 0.28, "e": 0.92}, {"w": "можно", "s": 0.96, "e": 1.16}, {"w": "законно", "s": 1.24, "e": 1.6}, {"w": "опустить", "s": 1.64, "e": 2.04}, {"w": "и", "s": 2.08, "e": 2.12}, {"w": "иногда", "s": 2.16, "e": 2.4}, {"w": "даже", "s": 2.44, "e": 2.64}, {"w": "вдвое", "s": 2.64, "e": 2.92}, {"w": "страховые", "s": 3.0, "e": 3.4}, {"w": "считают", "s": 3.44, "e": 3.76}, {"w": "цену", "s": 3.8, "e": 3.96}, {"w": "по", "s": 4.0, "e": 4.08}, {"w": "риску", "s": 4.12, "e": 4.4}, {"w": "гараж", "s": 4.52, "e": 4.76}, {"w": "вместо", "s": 4.8, "e": 5.04}, {"w": "улицы", "s": 5.12, "e": 5.36}, {"w": "небольшой", "s": 5.463, "e": 5.822}, {"w": "годовой", "s": 5.862, "e": 6.183}, {"w": "пробег", "s": 6.182, "e": 6.462}, {"w": "использование", "s": 6.542, "e": 7.022}, {"w": "по", "s": 7.102, "e": 7.182}, {"w": "выходным", "s": 7.222, "e": 7.542}, {"w": "вместо", "s": 7.582, "e": 7.822}, {"w": "ежедневного", "s": 7.903, "e": 8.463}, {"w": "и", "s": 8.582, "e": 8.622}, {"w": "все", "s": 8.742, "e": 8.862}, {"w": "это", "s": 8.943, "e": 9.062}, {"w": "снижает", "s": 9.102, "e": 9.502}, {"w": "цену", "s": 9.542, "e": 9.742}, {"w": "главное", "s": 9.903, "e": 10.182}, {"w": "оружие", "s": 10.182, "e": 10.463}, {"w": "то", "s": 10.565, "e": 10.645}, {"w": "бонус", "s": 10.645, "e": 10.925}, {"w": "мало", "s": 10.965, "e": 11.165}, {"w": "за", "s": 11.245, "e": 11.325}, {"w": "годы", "s": 11.365, "e": 11.565}, {"w": "без", "s": 11.605, "e": 11.725}, {"w": "аварий", "s": 11