щий испанский закон о безопасности граждан дает за это от 100 до 600 евро штрафа. Точная сумма зависит может от города и от того, по какому закону его оформят. Там есть определенные тоже вилки и может немножко штраф отличаться. Например, если вы пьете вино или пиво на террасе бара, то без проблем это можно. И в дни, когда город сам разрешил, например, на праздники, тогда разрешается употребление этих напитков. и во вино, и в общественных местах.", "gw": [{"w": "штраф", "s": 0.24, "e": 0.48}, {"w": "может", "s": 0.6, "e": 0.8}, {"w": "доходить", "s": 0.84, "e": 1.16}, {"w": "до", "s": 1.24, "e": 1.32}, {"w": "шестисот", "s": 1.44, "e": 1.84}, {"w": "евро", "s": 1.88, "e": 2.08}, {"w": "пиво", "s": 2.2, "e": 2.44}, {"w": "на", "s": 2.48, "e": 2.56}, {"w": "лавочке", "s": 2.6, "e": 2.92}, {"w": "или", "s": 2.96, "e": 3.12}, {"w": "вино", "s": 3.16, "e": 3.36}, {"w": "вечером", "s": 3.44, "e": 3.76}, {"w": "на", "s": 3.76, "e": 3.84}, {"w": "пляже", "s": 3.88, "e": 4.08}, {"w": "в", "s": 4.12, "e": 4.16}, {"w": "олимпийском", "s": 4.2, "e": 4.76}, {"w": "сообществе", "s": 4.76, "e": 5.2}, {"w": "прямо", "s": 5.342, "e": 5.583}, {"w": "запрещено", "s": 5.702, "e": 6.262}, {"w": "законом", "s": 6.503, "e": 6.942}, {"w": "о", "s": 7.062, "e": 7.102}, {"w": "здоровье", "s": 7.182, "e": 7.582}, {"w": "общий", "s": 7.743, "e": 7.982}, {"w": "испанский", "s": 8.022, "e": 8.422}, {"w": "закон", "s": 8.462, "e": 8.702}, {"w": "о", "s": 8.743, "e": 8.783}, {"w": "безопасности", "s": 8.862, "e": 9.422}, {"w": "граждан", "s": 9.462, "e": 9.783}, {"w": "дает", "s": 10.02, "e": 10.34}, {"w": "за", "s": 10.38, "e": 10.46}, {"w": "это", "s": 10.54, "e": 10.7}, {"w": "от", "s": 10.82, "e": 10.9}, {"w": "ста", "s": 11.02, "e": 11.18}, {"w": "до", "s": 11.3, "e": 11.38}, {"w": "шестисот", "s": 11.46, "e": 11.94}, {"w": "евро", "s": 12.1, "e": 12.3}, {"w": "штрафа", "s": 12.38, "e": 12.7}, {"w": "точная", "s": 12.82, "e": 13.14}, {"w": "сумма", "s": 13.18, "e": 13.42}, {"w": "зависеть", "s