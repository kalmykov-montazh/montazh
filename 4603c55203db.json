, "whisper": "штрафа. Точная сумма зависит может от города и от того, по какому закону"}, {"kind": "СТЫК-В-РЕЧИ", "t": 19.56, "why": "перед подрезкой голос громкий: -13.0 дБ от пика (после -42.9)", "strong": false, "giga": "определенные тоже вилки и может немножко штраф отличаться например если вы", "whisper": "определенные тоже вилки и может немножко штраф отличаться. Например, если вы пьете"}, {"kind": "СТЫК-В-РЕЧИ", "t": 29.15, "why": "перед подрезкой голос громкий: -11.1 дБ от пика (после -28.7)", "strong": false, "giga": "тогда разрешается употребление этих напитков пива вино и в общественных", "whisper": "тогда разрешается употребление этих напитков. и во вино, и в общественных"}, {"kind": "РАЗНОЧТЕНИЕ", "t": 30.09, "why": "GigaAM: «пива» / Whisper: «и во»", "strong": false, "giga": "употребление этих напитков пива вино и в общественных местах", "whisper": "употребление этих напитков. и во вино, и в общественных местах."}], "giga": "штраф может доходить до шестисот евро пиво на лавочке или вино вечером на пляже в олимпийском сообществе прямо запрещено законом о здоровье общий испанский закон о безопасности граждан дает за это от ста до шестисот евро штрафа точная сумма зависеть может от города и от того по какому закону его формят там есть определенные тоже вилки и может немножко штраф отличаться например если вы пьете вино или пиво на террасе бара то без проблем это можно и в дни когда город сам разрешил например на праздники тогда разрешается употребление этих напитков пива вино и в общественных местах", "whisper": "Штраф может доходить до 600 евро. Пиво на лавочке или вино вечером на пляже в Алисинском сообществе прямо запрещено законом о здоровье. Общий испанский закон о безопасности граждан дает за это от 100 до 600 евро штрафа. Точная сумма зависит может от города и от того, по какому закону его оформят. Там есть определенные тоже вилки и может немножко штраф отличаться. Например, если вы пьете вино или пиво на террасе бара, то без проблем это можно. И в дни, когда город сам разрешил, например, на праздники, тогда разрешается употребление этих напитков. и во вино, и в общественных местах.", "gw": [{"w": "штраф", "s": 0.24, "e": 0.48}, {"w": "может", "s": 0.6, "e": 0.8}, {"w": "доходить", "s": 0.84, "e": 1.16}, {"w": "до", "s": 1.24, "e": 1.36}, {"w": "шестисот", "s": 1.44, "e": 1.84}, {"w": "евро", "s": 1.92, "e": 2.08}, {"w": "пиво", "s": 2.2, "e": 2.44}, {"w": "на", "s": 2.48, "e": 2.56}, {"w": "лавочке", "s": 2.6, "e": 2.92}, {"w": "или", "s": 3.0, "e": 3.12}, {"w": "вино", "s": 3.16, "e": 3.36}, {"w": "вечером", "s": 3.44, "e": 3.76}, {"w": "на", "s": 3.76, "e": 3.84}, {"w": "пляже", "s": 3.88, "e": 4.12}, {"w": "в", "s": 4.12, "e": 4.16}, {"w": "олимпийском", "s": 4.24, "e": 4.76}, {"w": "сообществе", "s": 4.8, "e": 5.28}, {"w": "прямо", "s": 5.36, "e": 5.6}, {"w": "запрещено", "s": 5.68, "e": 6.28}, {"w": "законом", "s": 6.48, "e": 6.96}, {"w": "о", "s": 7.04, "e": 7.08}, {"w": "здоровье", "s": 7.2, "e": 7.6}, {"w": "общий", "s": 7.72, "e": 8.0}, {"w": "испанский", "s": 8.04, "e": 8.44}, {"w": "закон", "s": 8.48, "e": 8.68}, {"w": "о", "s": 8.76, "e": 8.8}, {"w": "безопасности", "s": 8.88, "e": 9.44}, {"w": "граждан", "s": 9.52, "e": 9.84}, {"w": "дает", "s": 10.04, "e": 10.32}, {"w": "за", "s": 10.4, "e": 10.48}, {"w": "это", "s": 10.56, "e": 10.68}, {"w": "от", "s": 10.8, "e": 10.92}, {"w": "ста", "s": 11.04, "e": 11.2}, {"w": "до", "s": 11.28, "e": 11.4}, {"w": "шестисот", "s": 11.48, "e": 11.92}, {"w": "евро", "s": 12.08, "e": 12.28}, {"w": "штрафа", "s": 12.4, "e": 12.68}, {"w": "точная", "s": 12.8, "e": 13.12}, {"w": "сумма", "s": 13.16, "e": 13.4}, {"w": "зависеть", "s": 13.44, "e": 13.8}, {"w": "может", "s": 13.88, "e": 14.08}, {"w": "от", "s": 14.23, "e": 14.31}, {"w": "города", "s": 14.43, "e": 14.71}, {"w": "и", "s": 14.75, "e": 14.79}, {"w": "от", "s": 14.87, "e": 14.99}, {"w": "того", "s": 15.03, "e": 15.23}, {"w": "по", "s": 15.27, "e": 15.35}, {"w": "какому", "s": 15.43, "e": 15.75}, {"w": "зак