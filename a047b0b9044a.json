ы слышат «метро,», в плане его нет", "strong": true, "giga": "такие как новый парк или линия метро они открыты для всех если проект", "whisper": "такие как новый парк или линия метро, они открыты для всех. Если проект"}], "giga": "здание может выглядеть как обычный дом но юридически оказывается объектом исторического наследия и тогда вы не сможете спокойно делать ремонт менять фасад или даже окна перед покупкой обязательно уточните входит ли дом в список охраняемых объектов или находится в зоне исторического интереса если здание признано объектом наследия любое изменение фасада перекраска установка кондиционеров или солнечных панелей должны обязательно согласовываться с муниципалитетом нарушение этих правил может привести к штрафам и даже писанию вернуть внешний вид к исходному состоянию как влияет статус земли урбана или рустика два одинаковых дома но налоги могут отличаться в несколько раз но на рустика могут запретить новое строительство или реконструкция почему стоит спросить про план реформы района цена квартиры может взлететь из за одного решения мэрии муниципальные планы реновации это такие как новый парк или линия метро они открыты для всех если проект утвержден цены на жилье поблизости растут еще до начала этих работ один официальный документ может избавить вас от серьезных ограничений и затрат в будущем", "whisper": "Здание может выглядеть как обычный дом, но юридически оказывается объектом исторического наследия, и тогда вы не сможете спокойно делать ремонт, менять фасад или даже окна. Перед покупкой обязательно уточните, входит ли дом в список охраняемых объектов или находится в зоне исторического интереса. Если здание признано объектом наследия, любое изменение фасада, перекраска, установка кондиционеров или солнечных панелей должны обязательно согласовываться с муниципалитетом. Нарушение этих правил может привести к штрафам и даже предписанию вернуть внешний вид к исходному состоянию. Как влияет статус земли? Урбана или рустика? Два одинаковых дома, но налоги могут отличаться в несколько раз. Но на рустика могут запретить новое строительство или реконструкцию. Почему стоит спросить про план реформы района? Цена квартиры может взлететь из -за одного решения мэрии. Муниципальные планы реновации, это такие как новый парк или линия метро, они открыты для всех. Если проект утвержден, цены на жилье поблизости растут еще до начала этих работ. Один официальный документ может избавить вас от серьезных ограничений и затрат в будущем.", "gw": [{"w": "здание", "s": 0.08, "e": 0.36}, {"w": "может", "s": 0.44, "e": 0.64}, {"w": "выглядеть", "s": 0.68, "e": 1.08}, {"w": "как", "s": 1.08, "e": 1.2}, {"w": "обычный", "s": 1.24, "e": 1.56}, {"w": "дом", "s": 1.6, "e": 1.76}, {"w": "но", "s": 1.88, "e": 2.0}, {"w": "юридически", "s": 2.16, "e": 2.68}, {"w": "оказывается", "s": 2.8, "e": 3.4}, {"w": "объектом", "s": 3.44, "e": 3.88}, {"w": "исторического", "s": 3.92, "e": 4.52}, {"w": "наследия", "s": 4.56, "e": 4.92}, {"w": "и", "s": 5.052, "e": 5.092}, {"w": "тогда", "s": 5.172, "e": 5.492}, {"w": "вы", "s": 5.612, "e": 5.692}, {"w": "не", "s": 5.772, "e": 5.852}, {"w": "сможете", "s": 5.892, "e": 6.212}, {"w": "спокойно", "s": 6.212, "e": 6.572}, {"w": "делать", "s": 6.652, "e": 6.852}, {"w": "ремонт", "s": 6.932, "e": 7.212}, {"w": "менять", "s": 7.292, "e": 7.572}, {"w": "фасад", "s": 7.612, "e": 7.932}, {"w": "или", "s": 8.092, "e": 8.252}, {"w": "даже", "s": 8.372, "e": 8.572}, {"w": "окна", "s": 8.692, "e": 8.932}, {"w": "перед", "s": 8.972, "e": 9.212}, {"w": "покупкой", "s": 9.252, "e": 9.612}, {"w": "обязательно", "s": 9.692, "e": 10.132}, {"w": "уточните", "s": 10.212, "e": 10.612}, {"w": "входит", "s": 10.69, "e": 11.01}, {"w": "ли", "s": 11.05, "e": 11.13}, {"w": "дом", "s": 11.17, "e": 11.33}, {"w": "в", "s": 11.37, "e": 11.41}, {"w": "список", "s": 11.49, "e": 11.77}, {"w": "охраняемых", "s": 11.85, "e": 12.37}, {"w": "объектов", "s": 12.41, "e": 12.81}, {"w": "или", "s": 12.85, "e": 13.01}, {"w": "находится", "s": 1