 за год примерно плюс пять процентов город растет сюда едут айтишники и удаленщики со всей европы кому подходит тем кто хочет теп теплую зиму и большой город сразу и готов к цене", "whisper": "Самая мягкая зима на материке у Малаги. Средняя температура в январе 12 ,5 градусов, ночью около 8, днем 17 градусов. Солнце почти 3000 часов в год, на севере Испании около 1700 часов, то есть практически в два раза меньше. Только за такую зиму нужно платить. Квартира площадью 70 квадратных метров в Малаге будет стоить около 1170 евро в месяц. По осенним данным самого большого сайта Испании Цена поднялась за год примерно плюс 5%. Город растет. Сюда едут айтишники и удаленщики со всей Европы. Кому и подходит. Тем, кто хочет теплую зиму и большой город сразу и готов к цене.", "gw": [{"w": "самая", "s": 0.36, "e": 0.68}, {"w": "мягкая", "s": 0.72, "e": 1.08}, {"w": "зима", "s": 1.12, "e": 1.28}, {"w": "на", "s": 1.36, "e": 1.44}, {"w": "материке", "s": 1.48, "e": 1.92}, {"w": "у", "s": 2.0, "e": 2.04}, {"w": "малоги", "s": 2.2, "e": 2.68}, {"w": "средняя", "s": 2.88, "e": 3.24}, {"w": "температура", "s": 3.28, "e": 3.76}, {"w": "в", "s": 3.8, "e": 3.84}, {"w": "январе", "s": 3.92, "e": 4.2}, {"w": "двенадцать", "s": 4.24, "e": 4.6}, {"w": "с", "s": 4.6, "e": 4.64}, {"w": "половиной", "s": 4.72, "e": 5.12}, {"w": "градусов", "s": 5.16, "e": 5.56}, {"w": "ночью", "s": 5.652, "e": 5.892}, {"w": "около", "s": 5.972, "e": 6.213}, {"w": "восьми", "s": 6.252, "e": 6.532}, {"w": "днем", "s": 6.772, "e": 7.013}, {"w": "семнадцать", "s": 7.093, "e": 7.532}, {"w": "градусов", "s": 7.612, "e": 8.012}, {"w": "солнце", "s": 8.172, "e": 8.532}, {"w": "почти", "s": 8.613, "e": 8.893}, {"w": "три", "s": 8.972, "e": 9.092}, {"w": "тысячи", "s": 9.172, "e": 9.492}, {"w": "часов", "s": 9.572, "e": 9.852}, {"w": "в", "s": 9.892, "e": 9.932}, {"w": "год", "s": 10.013, "e": 10.172}, {"w": "на", "s": 10.275, "e": 10.355}, {"w": "севере", "s": 10.435, "e": 10.715}, {"w": "испании", "s": 10.795, "e": 11.1